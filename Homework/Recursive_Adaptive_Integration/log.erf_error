\
	set terminal svg background "white" ;\
	set output "Error_function_error.svg" ;\
	set logscale xy ;\
	set xlabel "acc" ;\
	set ylabel "error" ;\
	set xrange [] reverse ;\
	set title "Difference my implementation erf(1) and tabulated value" ;\
	plot "erf1.txt" using 1:2 with linespoints title "|calculated erf(1) - tabulated|";\
	
