\
	set terminal svg background "white" ;\
	set output "Error_area_circle.svg" ;\
	set title "MC integration circle. The estimated error compared to acual error as function of N";\
	set logscale x ;\
	set xlabel "Number of evaluations (N)" ;\
	set ylabel "Error" ;\
	plot "area_circle.txt" using 1:3 with linespoints title "Estimated error", \
	"area_circle.txt" using 1:4 with linespoints title "Actual error"; \
	
